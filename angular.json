{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "cli": {
    "analytics": false,
    "schematicCollections": ["@angular-eslint/schematics"],
    "packageManager": "npm"
  },
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "coreui-angular": {
      "projectType": "library",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "projects/coreui-angular",
      "sourceRoot": "projects/coreui-angular",
      "prefix": "c",
      "architect": {
        "build": {
          "builder": "@angular/build:library",
          "options": {
            "tsConfig": "projects/coreui-angular/tsconfig.lib.json",
            "outputPath": "dist/coreui-angular",
            "allowedNonPeerDependencies": ["@popperjs/core"]
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/coreui-angular/tsconfig.lib.prod.json"
            },
            "development": {}
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "projects/coreui-angular/tsconfig.spec.json",
            "providersFile": "projects/coreui-angular/src/test-providers.ts",
            "runnerConfig": true
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": ["projects/coreui-angular/**/*.ts", "projects/coreui-angular/**/*.html"],
            "eslintConfig": "projects/coreui-angular/eslint.config.js"
          }
        }
      }
    },
    "coreui-angular-chartjs": {
      "projectType": "library",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "projects/coreui-angular-chartjs",
      "sourceRoot": "projects/coreui-angular-chartjs",
      "prefix": "c",
      "architect": {
        "build": {
          "builder": "@angular/build:library",
          "options": {
            "tsConfig": "projects/coreui-angular-chartjs/tsconfig.lib.json",
            "outputPath": "dist/coreui-angular-chartjs",
            "assets": ["projects/coreui-angular-chartjs/README.png"],
            "allowedNonPeerDependencies": ["@coreui/chartjs", "chart.js", "lodash-es"]
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/coreui-angular-chartjs/tsconfig.lib.prod.json"
            },
            "development": {
              "compilationMode": "full"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "projects/coreui-angular-chartjs/tsconfig.spec.json",
            "providersFile": "projects/coreui-angular-chartjs/src/test-providers.ts",
            "runnerConfig": true,
            "setupFiles": ["projects/coreui-angular-chartjs/src/test-setup.spec.ts"]
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": [
              "projects/coreui-angular-chartjs/**/*.ts",
              "projects/coreui-angular-chartjs/**/*.html"
            ],
            "eslintConfig": "projects/coreui-angular-chartjs/eslint.config.js"
          }
        }
      }
    },
    "coreui-icons-angular": {
      "projectType": "library",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "projects/coreui-icons-angular",
      "sourceRoot": "projects/coreui-icons-angular",
      "prefix": "c",
      "architect": {
        "build": {
          "builder": "@angular/build:library",
          "options": {
            "tsConfig": "projects/coreui-icons-angular/tsconfig.lib.json",
            "outputPath": "dist/coreui-icons-angular"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/coreui-icons-angular/tsconfig.lib.prod.json"
            },
            "development": {
              "compilationMode": "full"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "projects/coreui-icons-angular/tsconfig.spec.json",
            "providersFile": "projects/coreui-icons-angular/src/test-providers.ts",
            "runnerConfig": true
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": ["projects/coreui-icons-angular/**/*.ts", "projects/coreui-icons-angular/**/*.html"],
            "eslintConfig": "projects/coreui-icons-angular/eslint.config.js"
          }
        }
      }
    }
  },
  "schematics": {
    "@angular-eslint/schematics:application": {
      "setParserOptionsProject": true
    },
    "@angular-eslint/schematics:library": {
      "setParserOptionsProject": true
    },
    "@schematics/angular:component": {
      "standalone": true,
      "style": "scss",
      "type": "component"
    },
    "@schematics/angular:directive": {
      "standalone": true,
      "type": "directive"
    },
    "@schematics/angular:pipe": {
      "standalone": true,
      "typeSeparator": "."
    },
    "@schematics/angular:service": {
      "type": "service"
    },
    "@schematics/angular:guard": {
      "typeSeparator": "."
    },
    "@schematics/angular:interceptor": {
      "typeSeparator": "."
    },
    "@schematics/angular:module": {
      "typeSeparator": "."
    },
    "@schematics/angular:resolver": {
      "typeSeparator": "."
    }
  }
}
